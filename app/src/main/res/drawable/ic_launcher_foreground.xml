<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Hexagonal Glow Ring Border -->
    <path
        android:strokeWidth="1.5"
        android:strokeColor="#2600E676"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:pathData="M54,23 L79,37.5 L79,66.5 L54,81 L29,66.5 L29,37.5 Z" />

    <!-- Morphe 'M' Monogram Left Wing -->
    <path
        android:strokeWidth="0"
        android:pathData="M34,34 L42,34 L42,66 L34,66 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="34"
                android:startY="34"
                android:endX="42"
                android:endY="66"
                android:type="linear">
                <item android:offset="0.0" android:color="#00E676" />
                <item android:offset="1.0" android:color="#00B0FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Morphe 'M' Monogram Right Wing -->
    <path
        android:strokeWidth="0"
        android:pathData="M66,34 L74,34 L74,66 L66,66 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="74"
                android:startY="34"
                android:endX="66"
                android:endY="66"
                android:type="linear">
                <item android:offset="0.0" android:color="#00E676" />
                <item android:offset="1.0" android:color="#00B0FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center Morphe Chevron (Top Inward Fold) -->
    <path
        android:strokeWidth="0"
        android:pathData="M34,34 L54,53 L48,53 L34,39 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="34"
                android:startY="34"
                android:endX="54"
                android:endY="53"
                android:type="linear">
                <item android:offset="0.0" android:color="#69F0AE" />
                <item android:offset="1.0" android:color="#00E676" />
            </gradient>
        </aapt:attr>
    </path>

    <path
        android:strokeWidth="0"
        android:pathData="M74,34 L54,53 L60,53 L74,39 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="74"
                android:startY="34"
                android:endX="54"
                android:endY="53"
                android:type="linear">
                <item android:offset="0.0" android:color="#69F0AE" />
                <item android:offset="1.0" android:color="#00E676" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Dynamic Build Downloader Arrow (Center Dynamic Element) -->
    <path
        android:strokeWidth="0"
        android:pathData="M51,45 L57,45 L57,58 L63,58 L54,69 L45,58 L51,58 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="45"
                android:endX="54"
                android:endY="69"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFFF" />
                <item android:offset="0.5" android:color="#B9F6CA" />
                <item android:offset="1.0" android:color="#00E676" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bottom Build Platform Bracket -->
    <path
        android:strokeWidth="2.5"
        android:strokeColor="#00E676"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M38,72 L34,72 L34,75 L74,75 L74,72 L70,72" />

    <!-- Subtle Cyan Accent Dot at Center Target -->
    <path
        android:fillColor="#00E5FF"
        android:pathData="M54,73.5m-1,0a1,1 0 1,1 2,0a1,1 0 1,1 -2,0" />

</vector>